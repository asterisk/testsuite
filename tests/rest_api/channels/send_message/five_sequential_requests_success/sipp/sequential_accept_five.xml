<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<scenario name="ARI sendMessage five sequential success">
  <send retrans="500">
    <![CDATA[
      INVITE sip:s@127.0.0.1:5060 SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <sip:alice@[local_ip]:[local_port]>;tag=[call_number]
      To: <sip:s@127.0.0.1>
      Call-ID: [call_id]
      CSeq: [cseq] INVITE
      Contact: <sip:alice@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=- 1 1 IN IP4 [local_ip]
      s=-
      c=IN IP4 [local_ip]
      t=0 0
      m=audio 4000 RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
    ]]>
  </send>

  <recv response="100" optional="true" />
  <recv response="200" />

  <send>
    <![CDATA[
      ACK sip:s@127.0.0.1:5060 SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=[branch]
      From: <sip:alice@[local_ip]:[local_port]>;tag=[call_number]
      To: <sip:s@127.0.0.1>[peer_tag_param]
      Call-ID: [call_id]
      CSeq: [cseq] ACK
      Contact: <sip:alice@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv request="MESSAGE">
    <action>
      <ereg regexp="^Sequential five message one$"
            search_in="body" check_it="true" assign_to="1"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="MESSAGE">
    <action>
      <ereg regexp="text/plain"
            search_in="hdr" header="Content-Type:"
            check_it="true" assign_to="2"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="MESSAGE">
    <action>
      <ereg regexp="text/plain"
            search_in="hdr" header="Content-Type:"
            check_it="true" assign_to="3"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="MESSAGE">
    <action>
      <ereg regexp="text/plain"
            search_in="hdr" header="Content-Type:"
            check_it="true" assign_to="4"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="MESSAGE">
    <action>
      <ereg regexp="^Sequential five message five$"
            search_in="body" check_it="true" assign_to="5"/>
    </action>
  </recv>

  <Reference variables="1,2,3,4,5" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="BYE" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
</scenario>
